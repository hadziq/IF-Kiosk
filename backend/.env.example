# Every variable here is optional. The backend is the local WebSocket relay
# and serves a local build of the kiosk; it has no database.
#
# Copy to backend/.env and adjust. Never commit backend/.env.

# ── Server ───────────────────────────────────────────────────────────
PORT=8000

# ── QR code / phone pairing ──────────────────────────────────────────
# The kiosk builds the QR code from its own address. When it is opened as
# localhost, which a phone cannot reach, it uses this machine's LAN address
# instead, detected automatically. That is right when kiosk and phone share
# a WiFi network.
#
# Set this only when the phone must reach the kiosk some other way, for
# example through a tunnel. It replaces the origin in the QR code.
# PUBLIC_FRONTEND_URL=https://your-frontend-tunnel.ngrok.io
