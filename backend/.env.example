# Every variable here is optional. The defaults produce a working local setup
# against a PostgreSQL database named "ekiosk" on localhost.
#
# Copy to backend/.env and adjust. Never commit backend/.env.

# ── Server ───────────────────────────────────────────────────────────
PORT=8000

# ── Database ─────────────────────────────────────────────────────────
# Either set DATABASE_URL, or the individual DB_* values below.
# DATABASE_URL takes precedence and makes the DB_* values irrelevant.
# DATABASE_URL=postgresql://user:password@localhost:5432/ekiosk

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=your_postgres_password
DB_NAME=ekiosk

# ── QR code / phone pairing ──────────────────────────────────────────
# The kiosk shows a QR code the phone scans. By default the backend detects
# this machine's LAN address, which is correct when both are on the same WiFi.
#
# Set these only when the phone cannot reach that address - for example when
# the kiosk sits behind an ngrok tunnel.
# PUBLIC_BACKEND_URL=https://your-backend-tunnel.ngrok.io
# PUBLIC_FRONTEND_URL=https://your-frontend-tunnel.ngrok.io

# Port the Vite dev server runs on. Only used to build the QR URL in
# development, when the phone loads the dev server instead of the built app.
# FRONTEND_PORT=5173
